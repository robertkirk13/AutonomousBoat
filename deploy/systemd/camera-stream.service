[Unit]
Description=Pi Camera HLS Streamer
After=network.target

[Service]
Type=simple
User=chuck
# Env file is managed by the firmware's camera controller so MQTT
# CameraSet commands can change resolution/fps and enable/disable the stream.
# Missing file is OK on first boot — the `-` prefix tolerates that.
EnvironmentFile=-/etc/default/camera-stream
ExecStart=/usr/bin/python3 /home/chuck/AutonomousBoat/scripts/camera_stream.py --port 8554
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
