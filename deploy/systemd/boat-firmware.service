[Unit]
Description=BoatCore Firmware
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/python3 /home/chuck/AutonomousBoat/scripts/estop_monitor.py wait-release
ExecStart=/home/chuck/boat-firmware
WorkingDirectory=/home/chuck
EnvironmentFile=/home/chuck/.env
Environment=ESTOP_GPIO=5
Environment=ESTOP_ACTIVE_STATE=high
Environment=ESTOP_BIAS=pull-up
Environment=ESTOP_DEBOUNCE_MS=50
Environment=ESTOP_POLL_MS=25
Environment=ESTOP_SERVICE=boat-firmware.service
Restart=always
RestartSec=5
User=root
KillSignal=SIGINT
TimeoutStopSec=10
# Restart if it uses too much memory (256MB limit for Pi Zero 2W)
MemoryMax=256M
# Always restart, even on clean exit (autonomous system must stay running)
StartLimitIntervalSec=300
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
